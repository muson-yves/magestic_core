{
  "name": "majestic-core",
  "version": "1.0.0",
  "private": true,
  "description": "Majestic Core full-stack commerce application",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "vite frontend --config frontend/vite.config.mjs --host 0.0.0.0",
    "start": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "build": "vite build frontend --config frontend/vite.config.mjs",
    "preview": "vite preview frontend --config frontend/vite.config.mjs --host 0.0.0.0",
    "lint": "oxlint --config frontend/.oxlintrc.json frontend/src",
    "check:backend": "node --check backend/server.js && node --check backend/db.js",
    "check": "npm run check:backend && npm run lint && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "stripe": "^23.0.1",
    "@heroicons/react": "^2.2.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
